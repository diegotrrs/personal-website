---
import Section from "./Section.astro";
import type { StackGroupProps } from "@types";

interface Props {
  stack: StackGroupProps[];
}

const { stack } = Astro.props;
---

<Section text="Stack" href="stack">
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      stack.map(({ category, items }) => (
        <div class="rounded-2xl border border-neutral/20 bg-[#1c232d]/60 p-6">
          <h3 class="mb-5 font-mono text-xs tracking-[0.25em] text-primary uppercase">
            {category}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {items.map((item) => (
              <li class="rounded-lg border border-neutral/20 bg-black/60 px-3 py-1.5 text-sm text-white">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
