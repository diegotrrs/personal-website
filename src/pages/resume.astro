---
import { SITE_CONFIG, SITE_CONTENT } from "@config";
import "../styles/global.css";

const { hero, experience, projects, stack, education } = SITE_CONTENT;
const { socialLinks } = SITE_CONFIG;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{hero.name} — Resume</title>
    <style>
      @media print {
        .no-print {
          display: none;
        }

        body {
          font-size: 10px;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        main {
          max-width: 100%;
          padding: 0.5rem 1.5rem;
        }

        .grid {
          display: block !important;
        }

        .mb-7 {
          margin-bottom: 0.6rem !important;
        }
        .mb-8 {
          margin-bottom: 0.6rem !important;
        }
        .mb-6 {
          margin-bottom: 0.4rem !important;
        }
        .mb-5 {
          margin-bottom: 0.4rem !important;
        }
        .mb-4 {
          margin-bottom: 0.3rem !important;
        }
        .space-y-1 > * + * {
          margin-top: 0.1rem !important;
        }
        .py-14 {
          padding-top: 1rem !important;
          padding-bottom: 1rem !important;
        }
        .gap-12 {
          gap: 1.5rem !important;
        }

        .mb-7 {
          break-inside: avoid;
        }

        #skills-grid {
          columns: 2;
          column-gap: 2rem;
        }
        #skills-grid .mb-4 {
          break-inside: avoid;
        }
      }
    </style>
  </head>
  <body class="bg-white text-[#111] antialiased">
    <!-- Print / Download button -->
    <div class="no-print fixed top-4 right-4 z-50">
      <button
        onclick="window.print()"
        class="rounded-full bg-[#111] px-5 py-2.5 text-sm font-medium text-white hover:bg-[#333]"
      >
        Save as PDF
      </button>
    </div>

    <main class="mx-auto max-w-4xl px-10 py-14">
      <!-- Header -->
      <div class="mb-6 flex items-start justify-between">
        <div>
          <h1 class="mb-1 text-5xl font-bold tracking-tight text-[#111]">
            {hero.name}
          </h1>
          <p class="text-lg font-medium text-[#0066ff]">{hero.specialty}</p>
        </div>
        <div class="text-right text-xs text-[#555]">
          <p>London, UK · UK passport holder</p>
          <a href={`mailto:${hero.email}`} class="block hover:text-[#0066ff]"
            >{hero.email}</a
          >
          {
            socialLinks
              .filter((link) => !link.href.includes("linkedin"))
              .map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  class="block hover:text-[#0066ff]"
                >
                  {link.href.replace("https://", "")}
                </a>
              ))
          }
        </div>
      </div>

      <hr class="mb-6 border-[#ddd]" />

      <!-- Summary -->
      <p class="mb-6 text-sm leading-relaxed text-[#444]">{hero.summary}</p>

      <hr class="mb-8 border-[#ddd]" />

      <!-- Two-column body -->
      <div class="grid grid-cols-[1fr_280px] gap-12">
        <!-- Left: Work Experience + Projects -->
        <div>
          <section class="mb-8">
            <h2
              class="mb-5 text-xs font-semibold tracking-[0.15em] text-[#888] uppercase"
            >
              Work Experience
            </h2>
            {
              experience.map(
                ({
                  company,
                  position,
                  startDate,
                  endDate,
                  summary,
                  url,
                  textLinks,
                }) => (
                  <div class="mb-7">
                    <div class="mb-0.5 flex items-baseline justify-between gap-4">
                      <h3 class="text-base font-bold text-[#111]">
                        {position}
                      </h3>
                      <span class="shrink-0 text-xs text-[#888]">
                        {startDate} — {endDate}
                      </span>
                    </div>
                    {url ? (
                      <a
                        href={url}
                        target="_blank"
                        class="mb-2 block text-sm font-medium text-[#0066ff] hover:underline"
                      >
                        {company}
                      </a>
                    ) : (
                      <p class="mb-2 text-sm font-medium text-[#0066ff]">
                        {company}
                      </p>
                    )}
                    {Array.isArray(summary) ? (
                      <ul class="list-disc space-y-1 pl-4">
                        {summary.map((item) => {
                          let html = item;
                          if (textLinks) {
                            for (const [text, href] of Object.entries(
                              textLinks,
                            )) {
                              html = html.replaceAll(
                                text,
                                `<a href="${href}" target="_blank" class="text-[#0066ff] hover:underline">${text}</a>`,
                              );
                            }
                          }
                          return (
                            <li
                              class="text-sm leading-relaxed text-[#444]"
                              set:html={html}
                            />
                          );
                        })}
                      </ul>
                    ) : (
                      <p class="text-sm leading-relaxed text-[#444]">
                        {summary}
                      </p>
                    )}
                  </div>
                ),
              )
            }
          </section>

          <section>
            <h2
              class="mb-5 text-xs font-semibold tracking-[0.15em] text-[#888] uppercase"
            >
              Latest Projects
            </h2>
            {
              projects.map(({ name, period, summary }) => (
                <div class="mb-5">
                  <div class="mb-0.5 flex items-baseline justify-between gap-4">
                    <h3 class="text-sm font-bold text-[#111]">{name}</h3>
                    {period && (
                      <span class="shrink-0 text-xs text-[#888]">{period}</span>
                    )}
                  </div>
                  <p class="text-sm leading-relaxed text-[#444]">{summary}</p>
                </div>
              ))
            }
          </section>
        </div>

        <!-- Right: Skills + Education -->
        <aside>
          <section class="mb-8">
            <h2
              class="mb-5 text-xs font-semibold tracking-[0.15em] text-[#888] uppercase"
            >
              Skills
            </h2>
            <div id="skills-grid">
              {
                stack.map(({ category, items }) => (
                  <div class="mb-4">
                    <h3 class="mb-2 text-xs font-semibold tracking-[0.1em] text-[#aaa] uppercase">
                      {category}
                    </h3>
                    <div class="flex flex-wrap gap-1.5">
                      {items.map((item) => (
                        <span class="rounded-full border border-[#e0e0e0] px-2.5 py-0.5 text-xs text-[#444]">
                          {item}
                        </span>
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <section>
            <h2
              class="mb-5 text-xs font-semibold tracking-[0.15em] text-[#888] uppercase"
            >
              Education
            </h2>
            {
              education.map(({ institution, degree, summary }) => (
                <div class="mb-4">
                  <p class="text-sm font-semibold text-[#111]">{degree}</p>
                  <p class="text-sm text-[#0066ff]">{institution}</p>
                  {summary && (
                    <p class="mt-1 text-xs leading-relaxed text-[#666]">
                      {summary}
                    </p>
                  )}
                </div>
              ))
            }
          </section>
        </aside>
      </div>
    </main>
  </body>
</html>
